{
  "name": "Shooter",

  "globIgnorePaths": [
    "src/shared/Bodies/*.rbxm",
    "src/shared/Locker/Hats/*.rbxm",
    "src/shared/Locker/weapons/**/*.rbxm"
  ],

  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "WeaponTools": {
        "$path": "src/serverStorage/WeaponTools"
      }
    },

    "ReplicatedFirst": {
      "$path": "src/replicatedFirst"
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
